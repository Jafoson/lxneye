# --- Pflicht ---------------------------------------------------------------
# Öffentliche Adresse. In Produktion MUSS sie mit https:// beginnen.
PUBLIC_URL=https://lxneye.example.com

# Geheimer Schlüssel (mind. 32 Zeichen). Verschlüsselt gespeicherte Tokens/Keys.
#   openssl rand -base64 48
# Geht er verloren, müssen gespeicherte Tokens neu eingegeben werden.
SECRET_KEY=

# --- SSO (OpenID Connect). Anmeldung geht NUR darüber. -----------------------
# Redirect-URI beim Anbieter eintragen: <PUBLIC_URL>/auth/callback
OIDC_ISSUER=https://sso.example.com/realms/home
OIDC_CLIENT_ID=lxneye
OIDC_CLIENT_SECRET=

# Zugriffsregeln, mindestens eine ist Pflicht (kommagetrennt):
OIDC_ALLOWED_EMAILS=du@example.com
#OIDC_ALLOWED_DOMAINS=example.com
#OIDC_ALLOWED_GROUPS=admins
#OIDC_GROUPS_CLAIM=groups
#OIDC_REQUIRE_EMAIL_VERIFIED=true

# --- Optional ----------------------------------------------------------------
# Erhöht das GitHub-Rate-Limit beim Laden der Release Notes (nur lesender Token).
#GITHUB_TOKEN=
# Zusätzliche Container-Registries, die abgefragt werden dürfen (kommagetrennt).
#EXTRA_REGISTRY_HOSTS=registry.example.com
#SCAN_INTERVAL_MINUTES=360
#SESSION_TTL_HOURS=12
#SESSION_IDLE_MINUTES=120
